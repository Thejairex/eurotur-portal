# Copiar a .env.preprod (NO se versiona) y completar. Lo demas (base,
# puertos, cookie, servicios desconectados) ya esta forzado en
# docker-compose.preprod.yml.

APP_NAME="Portal Eurotur PREPROD"
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Generar una propia, DISTINTA a la de produccion:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Usuario de Postgres propio del preprod, con permisos SOLO sobre la base
# eurotur_portal_preprod (ver pasos de creacion en el chat / README).
DB_USERNAME=portal_preprod
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=info
